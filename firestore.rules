rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(tableId) {
      return /databases/$(database)/documents/tables/$(tableId)/members/$(request.auth.uid);
    }

    function isMember(tableId) {
      return signedIn() && exists(memberPath(tableId));
    }

    function isOwner(tableId) {
      return signedIn()
        && get(/databases/$(database)/documents/tables/$(tableId)).data.ownerId == request.auth.uid;
    }

    function nameOk(value) {
      return value is string && value.size() >= 1 && value.size() <= 40;
    }

    function displayNameOk(value) {
      return value is string && value.size() >= 1 && value.size() <= 40;
    }

    function seatNoteOk(value) {
      return value is string && value.size() <= 500;
    }

    function emailOk(value) {
      return value is string
        && value.size() <= 254
        && (value.size() == 0 || value.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$'));
    }

    function numberOk(value) {
      return (value is int || value is float) && value > 0;
    }

    function seatLimitOk(value) {
      return (value is int || value is float) && value >= 1 && value <= 40;
    }

    function memberCountOk(value) {
      return (value is int || value is float) && value >= 1 && value <= 40;
    }

    function joinPolicyOk(value) {
      return value in ['inviteOnly', 'firstComeFirstServe'];
    }

    function joinCodeOk(value) {
      return value is string && value.matches('^[A-Z0-9]{6}$');
    }

    function tableDataOk(data) {
      return data.keys().hasOnly([
          'name', 'ownerId', 'joinCode', 'seatLimit', 'joinPolicy', 'memberCount', 'createdAt'
        ])
        && nameOk(data.name)
        && joinCodeOk(data.joinCode)
        && seatLimitOk(data.seatLimit)
        && joinPolicyOk(data.joinPolicy)
        && memberCountOk(data.memberCount)
        && numberOk(data.createdAt)
        && data.memberCount <= data.seatLimit;
    }

    function memberCreateOk(tableId, uid) {
      return request.resource.data.keys().hasOnly(['displayName', 'role', 'seatNote', 'email', 'joinedAt'])
        && displayNameOk(request.resource.data.displayName)
        && seatNoteOk(request.resource.data.seatNote)
        && emailOk(request.resource.data.email)
        && numberOk(request.resource.data.joinedAt)
        && request.resource.data.role in ['owner', 'member']
        && (
          (
            uid == request.auth.uid
            && request.resource.data.role == 'owner'
            && get(/databases/$(database)/documents/tables/$(tableId)).data.ownerId == request.auth.uid
          )
          || (
            // Join by code (both policies): claim your own member seat.
            uid == request.auth.uid
            && request.resource.data.role == 'member'
          )
        );
    }

    function memberSelfUpdateOk() {
      return request.auth.uid == resource.id
        && request.resource.data.role == resource.data.role
        && request.resource.data.joinedAt == resource.data.joinedAt
        && displayNameOk(request.resource.data.displayName)
        && seatNoteOk(request.resource.data.seatNote)
        && emailOk(request.resource.data.email)
        && request.resource.data.keys().hasOnly(['displayName', 'role', 'seatNote', 'email', 'joinedAt']);
    }

    function noticeSubjectOk(value) {
      return value is string && value.size() >= 1 && value.size() <= 120;
    }

    function noticeBodyOk(value) {
      return value is string && value.size() >= 1 && value.size() <= 2000;
    }

    function noticeCreateOk() {
      return request.resource.data.keys().hasOnly(['subject', 'body', 'sentBy', 'sentAt', 'to'])
        && request.resource.data.sentBy == request.auth.uid
        && noticeSubjectOk(request.resource.data.subject)
        && noticeBodyOk(request.resource.data.body)
        && numberOk(request.resource.data.sentAt)
        && request.resource.data.to is list
        && request.resource.data.to.size() >= 1
        && request.resource.data.to.size() <= 40;
    }

    function fileNameOk(value) {
      return value is string && value.size() >= 1 && value.size() <= 80;
    }

    function fileTypeOk(value) {
      return value in [
        'image/jpeg',
        'image/png',
        'image/webp',
        'image/gif',
        'application/pdf'
      ];
    }

    function fileSizeOk(value) {
      return (value is int || value is float) && value > 0 && value <= 5 * 1024 * 1024;
    }

    function fileVisibilityOk(value) {
      return value in ['private', 'table', 'shared'];
    }

    function fileCreateOk() {
      return request.resource.data.keys().hasOnly([
          'name', 'ownerId', 'contentType', 'size', 'visibility', 'sharedWith', 'createdAt'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && fileNameOk(request.resource.data.name)
        && fileTypeOk(request.resource.data.contentType)
        && fileSizeOk(request.resource.data.size)
        && fileVisibilityOk(request.resource.data.visibility)
        && request.resource.data.sharedWith is list
        && request.resource.data.sharedWith.size() <= 40
        && !(request.auth.uid in request.resource.data.sharedWith)
        && (
          request.resource.data.visibility != 'shared'
          || request.resource.data.sharedWith.size() >= 1
        )
        && numberOk(request.resource.data.createdAt);
    }

    function fileUpdateOk() {
      return resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.contentType == resource.data.contentType
        && request.resource.data.size == resource.data.size
        && request.resource.data.keys().hasOnly([
          'name', 'ownerId', 'contentType', 'size', 'visibility', 'sharedWith', 'createdAt'
        ])
        && fileNameOk(request.resource.data.name)
        && fileVisibilityOk(request.resource.data.visibility)
        && request.resource.data.sharedWith is list
        && request.resource.data.sharedWith.size() <= 40
        && !(request.auth.uid in request.resource.data.sharedWith)
        && (
          request.resource.data.visibility != 'shared'
          || request.resource.data.sharedWith.size() >= 1
        );
    }

    function fileReadOk() {
      return resource.data.ownerId == request.auth.uid
        || resource.data.visibility == 'table'
        || (
          resource.data.visibility == 'shared'
          && request.auth.uid in resource.data.sharedWith
        );
    }

    function activityTypeOk(value) {
      return value in [
        'created', 'joined', 'left', 'removed', 'notice', 'settings', 'code_rotated'
      ];
    }

    function activityCreateOk() {
      return request.resource.data.keys().hasOnly([
          'type', 'actorId', 'actorName', 'summary', 'createdAt'
        ])
        && request.resource.data.actorId == request.auth.uid
        && activityTypeOk(request.resource.data.type)
        && displayNameOk(request.resource.data.actorName)
        && request.resource.data.summary is string
        && request.resource.data.summary.size() >= 1
        && request.resource.data.summary.size() <= 200
        && numberOk(request.resource.data.createdAt);
    }

    function ownerTableUpdateOk(tableId) {
      return isOwner(tableId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && tableDataOk(request.resource.data)
        && request.resource.data.seatLimit >= resource.data.memberCount
        && (
          request.resource.data.memberCount == resource.data.memberCount
          || request.resource.data.memberCount == resource.data.memberCount + 1
          || request.resource.data.memberCount == resource.data.memberCount - 1
        );
    }

    // Seat-count bump used with join / leave / remove in the same transaction.
    function memberCountBumpOk() {
      return signedIn()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name == resource.data.name
        && request.resource.data.seatLimit == resource.data.seatLimit
        && request.resource.data.joinPolicy == resource.data.joinPolicy
        && request.resource.data.joinCode == resource.data.joinCode
        && tableDataOk(request.resource.data)
        && (
          request.resource.data.memberCount == resource.data.memberCount + 1
          || request.resource.data.memberCount == resource.data.memberCount - 1
        );
    }

    function joinCodeDocOk(code) {
      return request.resource.data.keys().hasOnly([
          'tableId', 'name', 'seatLimit', 'memberCount', 'joinPolicy', 'ownerId'
        ])
        && request.resource.data.tableId is string
        && request.resource.data.tableId.size() >= 6
        && nameOk(request.resource.data.name)
        && seatLimitOk(request.resource.data.seatLimit)
        && memberCountOk(request.resource.data.memberCount)
        && joinPolicyOk(request.resource.data.joinPolicy)
        && request.resource.data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/tables/$(request.resource.data.tableId)).data.ownerId
          == request.auth.uid
        && get(/databases/$(database)/documents/tables/$(request.resource.data.tableId)).data.joinCode
          == code;
    }

    // After join/leave, any signed-in user may refresh the public seat count so
    // it matches the live table document.
    function joinCodeCountSyncOk(code) {
      return request.resource.data.keys().hasOnly([
          'tableId', 'name', 'seatLimit', 'memberCount', 'joinPolicy', 'ownerId'
        ])
        && request.resource.data.tableId == resource.data.tableId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.name == resource.data.name
        && request.resource.data.seatLimit == resource.data.seatLimit
        && request.resource.data.joinPolicy == resource.data.joinPolicy
        && memberCountOk(request.resource.data.memberCount)
        && get(/databases/$(database)/documents/tables/$(resource.data.tableId)).data.memberCount
          == request.resource.data.memberCount
        && get(/databases/$(database)/documents/tables/$(resource.data.tableId)).data.joinCode
          == code;
    }

    match /joinCodes/{code} {
      // Knowing the code is the gate; signed-in people may look one up by id.
      allow read: if signedIn() && joinCodeOk(code);

      allow create: if signedIn() && joinCodeOk(code) && joinCodeDocOk(code);

      allow update: if signedIn()
        && joinCodeOk(code)
        && (
          (
            resource.data.ownerId == request.auth.uid
            && joinCodeDocOk(code)
            && request.resource.data.tableId == resource.data.tableId
            && request.resource.data.ownerId == resource.data.ownerId
          )
          || joinCodeCountSyncOk(code)
        );

      allow delete: if signedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    match /tables/{tableId} {
      // Single-doc get is allowed for any signed-in user so a join-code lookup
      // can open the seat transaction. Listing stays narrow so tables cannot be
      // scraped from the collection.
      allow get: if signedIn();
      allow list: if signedIn() && (
        resource.data.ownerId == request.auth.uid
        || isMember(tableId)
        || resource.data.joinPolicy == 'firstComeFirstServe'
      );

      allow create: if signedIn()
        && tableDataOk(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberCount == 1;

      allow update: if ownerTableUpdateOk(tableId) || memberCountBumpOk();

      allow delete: if isOwner(tableId);

      match /members/{uid} {
        allow read: if isMember(tableId)
          || (signedIn() && request.auth.uid == uid);

        allow create: if signedIn() && memberCreateOk(tableId, uid);

        allow update: if isMember(tableId) && memberSelfUpdateOk();

        allow delete: if isOwner(tableId)
          || (signedIn() && request.auth.uid == uid);
      }

      match /notices/{noticeId} {
        allow read: if isMember(tableId);
        allow create: if isMember(tableId) && noticeCreateOk();
        allow update: if false;
        allow delete: if isOwner(tableId);
      }

      match /files/{fileId} {
        allow read: if isMember(tableId) && fileReadOk();
        allow create: if isMember(tableId) && fileCreateOk();
        allow update: if isMember(tableId) && fileUpdateOk();
        allow delete: if isMember(tableId)
          && resource.data.ownerId == request.auth.uid;
      }

      match /activity/{activityId} {
        allow read: if isMember(tableId);
        allow create: if isMember(tableId) && activityCreateOk();
        allow update: if false;
        allow delete: if isOwner(tableId);
      }
    }
  }
}
