rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(tableId) {
      return /databases/$(database)/documents/tables/$(tableId)/members/$(request.auth.uid);
    }

    function isMember(tableId) {
      return signedIn() && exists(memberPath(tableId));
    }

    function isOwner(tableId) {
      return signedIn()
        && get(/databases/$(database)/documents/tables/$(tableId)).data.ownerId == request.auth.uid;
    }

    function nameOk(value) {
      return value is string && value.size() >= 1 && value.size() <= 40;
    }

    function displayNameOk(value) {
      return value is string && value.size() >= 1 && value.size() <= 40;
    }

    function seatNoteOk(value) {
      return value is string && value.size() <= 500;
    }

    function emailOk(value) {
      return value is string
        && value.size() <= 254
        && (value.size() == 0 || value.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$'));
    }

    // Web clients store whole numbers as floats; REST/admin may use ints.
    function numberOk(value) {
      return (value is int || value is float) && value > 0;
    }

    function memberCreateOk(tableId, uid) {
      return request.resource.data.keys().hasOnly(['displayName', 'role', 'seatNote', 'email', 'joinedAt'])
        && displayNameOk(request.resource.data.displayName)
        && seatNoteOk(request.resource.data.seatNote)
        && emailOk(request.resource.data.email)
        && numberOk(request.resource.data.joinedAt)
        && request.resource.data.role in ['owner', 'member']
        && (
          (
            uid == request.auth.uid
            && request.resource.data.role == 'owner'
            && get(/databases/$(database)/documents/tables/$(tableId)).data.ownerId == request.auth.uid
          )
          || (
            isOwner(tableId)
            && uid != request.auth.uid
            && request.resource.data.role == 'member'
          )
        );
    }

    function memberSelfUpdateOk() {
      return request.auth.uid == resource.id
        && request.resource.data.role == resource.data.role
        && request.resource.data.joinedAt == resource.data.joinedAt
        && displayNameOk(request.resource.data.displayName)
        && seatNoteOk(request.resource.data.seatNote)
        && emailOk(request.resource.data.email)
        && request.resource.data.keys().hasOnly(['displayName', 'role', 'seatNote', 'email', 'joinedAt']);
    }

    match /tables/{tableId} {
      // OwnerId equality lets "tables I own" queries pass rule checks.
      // Membership still covers invited members opening a table by id.
      allow read: if isMember(tableId)
        || (signedIn() && resource.data.ownerId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'createdAt'])
        && nameOk(request.resource.data.name)
        && request.resource.data.ownerId == request.auth.uid
        && numberOk(request.resource.data.createdAt);

      allow update: if isOwner(tableId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && nameOk(request.resource.data.name)
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'createdAt']);

      allow delete: if isOwner(tableId);

      match /members/{uid} {
        allow read: if isMember(tableId);

        allow create: if signedIn() && memberCreateOk(tableId, uid);

        allow update: if isMember(tableId) && memberSelfUpdateOk();

        allow delete: if isOwner(tableId)
          || (signedIn() && request.auth.uid == uid);
      }

      // Notice log is created only by the Cloud Function (Admin SDK).
      // Owners may delete notices when tearing down a table.
      match /notices/{noticeId} {
        allow read: if isMember(tableId);
        allow create, update: if false;
        allow delete: if isOwner(tableId);
      }
    }
  }
}
